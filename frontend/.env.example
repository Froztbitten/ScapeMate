# Copy to `.env` and fill in. Vite only exposes vars prefixed with VITE_.
#
# These come from the Firebase console:
#   Project settings > General > Your apps > SDK setup and configuration.
# Firebase web config is not secret — it ships in the client bundle by
# design. Access is controlled by your Realtime Database rules, not by
# hiding these values.
VITE_REACT_APP_API_KEY=
VITE_REACT_APP_AUTH_DOMAIN=
VITE_REACT_APP_PROJECT_ID=
VITE_REACT_APP_DATABASE_URL=
VITE_REACT_APP_MESSAGING_SENDER_ID=
VITE_REACT_APP_APP_ID=
VITE_REACT_APP_MEASUREMENT_ID=

# Base URL of the Cloud Functions API.
#   local emulator: http://localhost:5001/osrs-companion-app/us-central1/api
#   deployed:       https://scapemate.net
VITE_REACT_APP_API_URL=
